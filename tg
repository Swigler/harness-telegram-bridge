#!/usr/bin/env bash
# tg <runtime> <bot> [extra args...]
#
# Examples:
#   tg claude buzz          # Claude session on buzz bot
#   tg opencode gherutza    # OpenCode session on gherutza bot
#   tg anon buzz            # blank Claude, no project context
#
# Bots:    ~/.claude/channels/telegram/bots.json  (name → port)
# Runtimes: ~/.claude/channels/telegram/runtimes/ (one script per runtime)
# Tokens:  ~/.claude/channels/telegram/<bot>/.env  (TELEGRAM_BOT_TOKEN + TELEGRAM_MCP_PORT)
set -uo pipefail

BASE_DIR="$HOME/.claude/channels/telegram"
BOTS_JSON="$BASE_DIR/bots.json"
RUNTIMES_DIR="$BASE_DIR/runtimes"

# ── Parse args ────────────────────────────────────────────────────────────
RUNTIME="${1:-}"
BOT_NAME="${2:-}"
shift 2 2>/dev/null || true

# ── Subcommands (intercept before help check — these accept empty BOT_NAME) ──

# Setup wizard
if [[ "$RUNTIME" == "setup" ]]; then
  BOT="${BOT_NAME:-}"

  # Bot name
  if [[ -z "$BOT" ]]; then
    read -rp "Bot name (e.g. bot1, mybot): " BOT
  fi
  if [[ -z "$BOT" ]]; then
    echo "Bot name cannot be empty." >&2
    exit 1
  fi
  if [[ "$BOT" =~ [^a-zA-Z0-9_-] ]]; then
    echo "Bot name must be alphanumeric (a-z, 0-9, -, _)." >&2
    exit 1
  fi

  BOT_DIR="$BASE_DIR/$BOT"
  if [[ -f "$BOT_DIR/.env" ]]; then
    echo "Bot '$BOT' already exists at $BOT_DIR" >&2
    exit 1
  fi

  # Token
  read -rp "Telegram bot token (from @BotFather): " TOKEN
  if [[ -z "$TOKEN" ]]; then
    echo "Token cannot be empty." >&2
    exit 1
  fi

  # Verify token
  echo "Verifying token..."
  BOT_INFO=$(curl -sf "https://api.telegram.org/bot${TOKEN}/getMe" 2>/dev/null)
  if [[ $? -ne 0 ]] || ! echo "$BOT_INFO" | python3 -c "import json,sys; d=json.load(sys.stdin); assert d['ok']" 2>/dev/null; then
    echo "Invalid token — getMe failed." >&2
    exit 1
  fi
  BOT_USERNAME=$(echo "$BOT_INFO" | python3 -c "import json,sys; print(json.load(sys.stdin)['result']['username'])")
  echo "Token valid — @$BOT_USERNAME"

  # Port — auto-assign next available
  if [[ -f "$BOTS_JSON" ]]; then
    NEXT_PORT=$(python3 -c "
import json
b = json.load(open('$BOTS_JSON'))
ports = [v['port'] for v in b.values()]
print(max(ports) + 1)
")
  else
    NEXT_PORT=3456
  fi
  read -rp "Port [$NEXT_PORT]: " PORT
  PORT="${PORT:-$NEXT_PORT}"

  # Your Telegram user ID — the allowlist is gated on it. Default: whatever an existing bot uses.
  DEFAULT_ID=$(python3 -c "
import glob, json
for f in sorted(glob.glob('$BASE_DIR/*/access.json')):
    try:
        ids = json.load(open(f)).get('allowFrom') or []
    except Exception:
        continue
    if ids:
        print(ids[0]); break
" 2>/dev/null)
  read -rp "Your Telegram user ID${DEFAULT_ID:+ [$DEFAULT_ID]} (ask @userinfobot): " ALLOW_ID
  ALLOW_ID="${ALLOW_ID:-$DEFAULT_ID}"
  if [[ ! "$ALLOW_ID" =~ ^[0-9]+$ ]]; then
    echo "Telegram user ID must be numeric." >&2
    exit 1
  fi

  # Create state dir + .env
  mkdir -p "$BOT_DIR"
  cat > "$BOT_DIR/.env" << EOF
TELEGRAM_BOT_TOKEN=$TOKEN
TELEGRAM_MCP_PORT=$PORT
EOF
  chmod 600 "$BOT_DIR/.env"

  # Create access.json with default allowlist
  cat > "$BOT_DIR/access.json" << EOF
{"dmPolicy":"allowlist","allowFrom":["$ALLOW_ID"]}
EOF

  # Update bots.json
  if [[ -f "$BOTS_JSON" ]]; then
    python3 -c "
import json
b = json.load(open('$BOTS_JSON'))
b['$BOT'] = {'port': $PORT}
json.dump(b, open('$BOTS_JSON', 'w'), indent=2)
print('Updated bots.json')
"
  else
    echo "{\"$BOT\": {\"port\": $PORT}}" > "$BOTS_JSON"
    echo "Created bots.json"
  fi

  # Enable + start systemd unit
  systemctl --user enable "telegram-mcp@${BOT}.service" 2>/dev/null
  systemctl --user start "telegram-mcp@${BOT}.service" 2>/dev/null

  echo ""
  echo "Done! Bot '$BOT' (@$BOT_USERNAME) ready on port $PORT."
  echo ""
  echo "  tg claude $BOT       # Claude Code session"
  echo "  tg opencode $BOT     # OpenCode session"
  echo "  tg anon $BOT         # Blank Claude session"
  exit 0
fi

# ── Always-on daemon: tg start <runtime> <bot> [workdir] ──────────────────
if [[ "$RUNTIME" == "start" ]]; then
  DAEMON_RT="$BOT_NAME"
  DAEMON_BOT="${1:-}"
  DAEMON_DIR="${2:-$PWD}"
  shift 2 2>/dev/null || shift 1 2>/dev/null || true

  if [[ -z "$DAEMON_RT" || -z "$DAEMON_BOT" ]]; then
    echo "Usage: tg start <runtime> <bot> [workdir]" >&2
    echo "  e.g. tg start claude buzz" >&2
    exit 1
  fi

  if [[ ! "$DAEMON_RT" =~ ^(claude|kimi|opencode)$ ]]; then
    echo "Daemon runtime must be claude, kimi, or opencode." >&2
    exit 1
  fi

  # Verify bot exists
  if [[ ! -f "$BASE_DIR/$DAEMON_BOT/.env" ]]; then
    echo "Bot '$DAEMON_BOT' not found. Run: tg setup $DAEMON_BOT" >&2
    exit 1
  fi

  UNIT="tg-daemon@${DAEMON_RT}-${DAEMON_BOT}.service"
  POLLER="telegram-mcp@${DAEMON_BOT}.service"

  # Stop MCP poller — two pollers on same token = 409
  systemctl --user stop "$POLLER" 2>/dev/null
  systemctl --user disable "$POLLER" 2>/dev/null

  # Check no other daemon on this bot
  EXISTING=$(systemctl --user list-units --type=service --state=running --no-legend 2>/dev/null \
    | grep "tg-daemon@.*-${DAEMON_BOT}\.service" \
    | grep -v "$UNIT" \
    | awk '{print $1}')
  if [[ -n "$EXISTING" ]]; then
    echo "Bot '$DAEMON_BOT' already running: $EXISTING" >&2
    echo "Stop it first: tg stop $DAEMON_BOT" >&2
    exit 1
  fi

  # Set work directory via environment override
  mkdir -p "$HOME/.config/systemd/user/tg-daemon@${DAEMON_RT}-${DAEMON_BOT}.service.d"
  cat > "$HOME/.config/systemd/user/tg-daemon@${DAEMON_RT}-${DAEMON_BOT}.service.d/workdir.conf" << EOF
[Service]
Environment="TG_WORK_DIR=$DAEMON_DIR"
EOF

  systemctl --user daemon-reload
  systemctl --user enable "$UNIT" 2>/dev/null
  systemctl --user start "$UNIT"

  echo "tg: started $DAEMON_RT on $DAEMON_BOT (always-on)"
  systemctl --user status "$UNIT" --no-pager 2>&1 | head -5
  exit 0
fi

# ── Stop daemon: tg stop <bot> ────────────────────────────────────────────
if [[ "$RUNTIME" == "stop" ]]; then
  STOP_BOT="$BOT_NAME"
  if [[ -z "$STOP_BOT" ]]; then
    echo "Usage: tg stop <bot>" >&2
    exit 1
  fi

  # Find and stop any daemon on this bot
  UNITS=$(systemctl --user list-units --type=service --no-legend 2>/dev/null \
    | grep "tg-daemon@.*-${STOP_BOT}\.service" \
    | awk '{print $1}')

  if [[ -z "$UNITS" ]]; then
    echo "No daemon running on '$STOP_BOT'." >&2
    exit 1
  fi

  for u in $UNITS; do
    systemctl --user stop "$u"
    systemctl --user disable "$u" 2>/dev/null
    echo "Stopped: $u"
  done

  # Re-enable MCP poller for dev bridge use
  POLLER="telegram-mcp@${STOP_BOT}.service"
  systemctl --user enable "$POLLER" 2>/dev/null
  systemctl --user start "$POLLER" 2>/dev/null
  echo "Restarted MCP poller: $POLLER"
  exit 0
fi

# ── Daemon status: tg status ─────────────────────────────────────────────
if [[ "$RUNTIME" == "status" ]]; then
  echo "=== Daemons ==="
  systemctl --user list-units --type=service --no-legend 2>/dev/null \
    | grep "tg-daemon@" \
    | awk '{printf "  %-40s %s\n", $1, $3}'

  echo ""
  echo "=== MCP Pollers ==="
  systemctl --user list-units --type=service --no-legend 2>/dev/null \
    | grep "telegram-mcp@" \
    | awk '{printf "  %-40s %s\n", $1, $3}'

  echo ""
  echo "=== Bots ==="
  if [[ -f "$BOTS_JSON" ]]; then
    python3 -c "import json; [print(f'  {k}') for k in json.load(open('$BOTS_JSON'))]"
  fi
  exit 0
fi

# Dispatch (agent management)
if [[ "$RUNTIME" == "dispatch" ]]; then
  exec "$HOME/agents/dispatch" "$BOT_NAME" "$@"
fi

# ── Help (after subcommands, so tg setup / tg dispatch aren't swallowed) ──
if [[ "$RUNTIME" == "help" || "$RUNTIME" == "--help" || "$RUNTIME" == "-h" || -z "$RUNTIME" || -z "$BOT_NAME" ]]; then
  cat >&2 << 'HELP'
tg — Telegram bot launcher

Interactive (MCP bridge, needs terminal):
  tg claude buzz           Claude Code session on buzz
  tg anon buzz             Blank Claude (no project context)

Always-on daemons (no terminal needed):
  tg start kimi preotzel       Start Kimi daemon on preotzel
  tg start opencode opncd123   Start OpenCode daemon on opncd123
  tg start claude buzz         Start Claude daemon (needs ANTHROPIC_API_KEY)
  tg stop preotzel             Stop daemon, re-enable MCP poller
  tg status                    Show all daemons, pollers, and bots

Any runtime on any bot. Swap anytime: tg stop <bot>, tg start <runtime> <bot>.

Setup:
  tg setup                 Add a new bot (interactive wizard)
  tg setup mybot           Add bot named "mybot"
HELP
  echo "" >&2
  if [[ -d "$RUNTIMES_DIR" ]]; then
    echo "Runtimes: $(ls "$RUNTIMES_DIR" | tr '\n' ' ')" >&2
  fi
  if [[ -f "$BOTS_JSON" ]]; then
    echo "Bots:     $(python3 -c "import json; print(' '.join(json.load(open('$BOTS_JSON'))))")" >&2
  fi
  exit 0
fi

# ── Resolve runtime ───────────────────────────────────────────────────────
RUNTIME_SCRIPT="$RUNTIMES_DIR/$RUNTIME"
if [[ ! -x "$RUNTIME_SCRIPT" ]]; then
  echo "Unknown runtime '$RUNTIME'." >&2
  echo "Available: $(ls "$RUNTIMES_DIR" | tr '\n' ' ')" >&2
  exit 1
fi

# ── Resolve bot ───────────────────────────────────────────────────────────
if [[ ! -f "$BOTS_JSON" ]]; then
  echo "No bots.json at $BOTS_JSON" >&2
  exit 1
fi

# Parse port from bots.json with pure bash (no jq, no bun)
PORT=$(python3 -c "import json,sys; b=json.load(open('$BOTS_JSON')); print(b['$BOT_NAME']['port'])" 2>/dev/null)
if [[ -z "$PORT" ]]; then
  echo "Unknown bot '$BOT_NAME'." >&2
  echo "Available: $(python3 -c "import json; print(' '.join(json.load(open('$BOTS_JSON'))))")" >&2
  exit 1
fi

STATE_DIR="$BASE_DIR/$BOT_NAME"

if [[ ! -f "$STATE_DIR/.env" ]]; then
  echo "No .env at $STATE_DIR/.env" >&2
  echo "Create it with: TELEGRAM_BOT_TOKEN=<token>" >&2
  echo "                TELEGRAM_MCP_PORT=$PORT" >&2
  exit 1
fi

# ── Pin check ─────────────────────────────────────────────────────────────
LOCK="$STATE_DIR/pinned.lock"
if [[ -f "$LOCK" ]] && kill -0 "$(cat "$LOCK" 2>/dev/null)" 2>/dev/null; then
  echo "Bot '$BOT_NAME' is already pinned to pid $(cat "$LOCK")." >&2
  echo "Close that session first, or: kill $(cat "$LOCK")" >&2
  exit 1
fi
rm -f "$LOCK"

# ── Ensure poller is running ─────────────────────────────────────────────
POLLER_UNIT="telegram-mcp@${BOT_NAME}.service"
systemctl --user start "$POLLER_UNIT" 2>/dev/null

# ── Export env for the proxy ──────────────────────────────────────────────
export TELEGRAM_PIN=1
export TELEGRAM_STATE_DIR="$STATE_DIR"
export TELEGRAM_MCP_PORT="$PORT"
export TELEGRAM_MCP_URL="http://localhost:$PORT"
export TELEGRAM_POLLER_UNIT="$POLLER_UNIT"

echo "tg: $RUNTIME → $BOT_NAME (port $PORT)"
exec "$RUNTIME_SCRIPT" "$@"
